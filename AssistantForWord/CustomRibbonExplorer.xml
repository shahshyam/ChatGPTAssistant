<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
	<ribbon>
		<tabs>
			<tab id="Assistant" label="AI Assistant">
				<group id="MyGroup"
					   label="My Group">
					<button id="chatgpt" size="large" label="ChatGPT"/>
					<toggleButton  id="btnPanel" label="Settings" getPressed="GetPressed" size="large" onAction="ShowSetting"/>
					<separator/>
				</group>
				<group id="group1" label="Toggle Group">
					<toggleButton id="toggleButton1" label="Option 1" getPressed="GroupGetPressed" onAction="ToggleButton_Click"/>
					<toggleButton id="toggleButton2" label="Option 2" getPressed="GroupGetPressed" onAction="ToggleButton_Click"/>
					<toggleButton id="toggleButton3" label="Option 3" getPressed="GroupGetPressed" onAction="ToggleButton_Click"/>
				</group>
			</tab>
		</tabs>
	</ribbon>
	<contextMenus>
		<contextMenu idMso="ContextMenuText">
			<menu id="mainAssitant" label="Assistant" getVisible="IsVisibleAssistant">
			</menu>
		</contextMenu>
	</contextMenus>
</customUI>

