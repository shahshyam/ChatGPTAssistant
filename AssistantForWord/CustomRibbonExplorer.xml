<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
	<ribbon>
		<tabs>
			<tab id="Assistant" label="AI Assistant">
				<group id="MyGroup"
					   label="My Group">					
					<toggleButton  id="btnPanel" label="Settings" getPressed="GetPressed" size="large" onAction="ShowSetting"/>
					<separator/>
				</group>				
				<group id="group1" label="Selected Text Option" >
					<toggleButton id="btnToggleInsertAfter" label="Insert After" getPressed="GroupGetPressed" onAction="ToggleButton_Click" size="large"/>
					<toggleButton id="btnToggleReplace" label="Replace" getPressed="GroupGetPressed" onAction="ToggleButton_Click" size="large"/>
					<toggleButton id="btnToggleInsertOnLocation" label="Insert on Location" getPressed="GroupGetPressed" onAction="ToggleButton_Click" size="large"/>
				</group>
			</tab>
		</tabs>
	</ribbon>
	<contextMenus>
		<contextMenu idMso="ContextMenuText">			
			<dynamicMenu id="AssistantContextMenu" label="Assistant new " getContent="GetMenuContent" getVisible="IsVisibleAssistant"/>
		</contextMenu>
	</contextMenus>
</customUI>

